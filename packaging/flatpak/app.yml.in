# Flatpak 清单模板 —— 由 flatpak/build-flatpak.sh 渲染。
#
# 关于沙箱：**沙箱不改变平台能力边界**。GNOME 下没有 layer-shell、portal 不给
# key-up，Flatpak 内外完全一样。沙箱只多两件事：截屏与全局热键必须走 portal
# （反而更规范），以及文件访问要通过 file chooser 授权。
#
# 叠字窗口本身**不受沙箱影响**——它是应用自己的顶层窗口，置顶/点击穿透由合成器
# 按窗口属性决定，与 Flatpak 无关。
app-id: @APP_ID@
runtime: org.freedesktop.Platform
runtime-version: '24.08'
sdk: org.freedesktop.Sdk
command: @APP_SLUG@

finish-args:
  # 在线翻译后端（Lingva / DeepL / OpenAI 兼容端点 / 本地推理服务器）
  - --share=network
  # Wayland 优先、X11 兜底。X11 会话下才能做「点击穿透 + 全局指针读取」（态 0），
  # 所以这个 socket 不是可选装饰——它是功能开关。
  - --socket=wayland
  - --socket=fallback-x11
  - --share=ipc
  # 游戏原声采集（PipeWire 的 monitor 源）。注意：默认只有自己的音频是
  # 隔离的，录制别的应用需要用户授权。
  - --socket=pulseaudio
  # OCR 与本地模型推理的 GPU 加速
  - --device=dri
  # 屏幕捕获（ScreenCast）与全局快捷键（GlobalShortcuts）都经由 portal。
  # 这两个 talk-name 是所有 Linux 桌面上唯一可移植的做法。
  - --talk-name=org.freedesktop.portal.Desktop
  - --talk-name=org.freedesktop.portal.Flatpak
  # 配置与数据目录（翻译历史、语言包、模型缓存）。
  # 语言包与模型有几 GB，放 xdg-data 而不是 ~/.var/app 的默认位置，
  # 是为了让用户能把它们放到别的大盘上。
  - --filesystem=xdg-config/@APP_ID@:create
  - --filesystem=xdg-data/@APP_ID@:create
  # 刻意不加 --filesystem=home 或 host：
  #   Yomitan 词典目录、截图保存位置、Anki 媒体目录都通过 file chooser portal 授权，
  #   用户点一次即可，不必把整个家目录交出去。

# 如果载荷**自带 JRE**（推荐：用 jpackage 的 app-image，运行时已随包），
# 就不需要下面这个 sdk-extension。保留注释是为了说明另一条路：
#   sdk-extensions:
#     - org.freedesktop.Sdk.Extension.openjdk21
#   build-options:
#     append-path: /usr/lib/sdk/openjdk21/bin
#     env:
#       JAVA_HOME: /usr/lib/sdk/openjdk21/jre

modules:
  - name: @APP_SLUG@
    buildsystem: simple
    build-commands:
      # 载荷按「已装好的 FHS 树」传入，这里映射到 Flatpak 的 /app 根。
      # 启动器自己会找家（见 assets/app-launcher.sh.in），所以 /app/lib
      # 与 deb/rpm 的 /usr/lib 两种位置它都能认。
      - install -Dm755 usr/bin/@APP_SLUG@ /app/bin/@APP_SLUG@
      - mkdir -p /app/lib/@APP_SLUG@
      - cp -a usr/lib/@APP_SLUG@/. /app/lib/@APP_SLUG@/
      - install -Dm644 usr/share/applications/@APP_ID@.desktop /app/share/applications/@APP_ID@.desktop
      - install -Dm644 usr/share/metainfo/@APP_ID@.metainfo.xml /app/share/metainfo/@APP_ID@.metainfo.xml
      - install -Dm644 usr/share/icons/hicolor/scalable/apps/@APP_ID@.svg /app/share/icons/hicolor/scalable/apps/@APP_ID@.svg
      # 叠字层是 X11/Wayland 原生窗口，JVM 需要能加载包内的 .so
      - install -d /app/extensions
    sources:
      - type: dir
        path: "@PAYLOAD_REL@"
